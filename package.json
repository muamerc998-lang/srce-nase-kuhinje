{
  "name": "srce-nase-kuhinje",
  "version": "0.1.0",
  "private": true,
  "description": "Srce naše kuhinje — praktična digitalna kuharica (Next.js + Payload CMS + PostgreSQL)",
  "type": "module",
  "scripts": {
    "db": "tsx scripts/local-db.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "taxonomy": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-taxonomy.ts",
    "seed:demo": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-demo.ts",
    "demo:remove": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/remove-demo.ts",
    "content:import": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-content.ts",
    "content:export": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/export-content.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config ./vitest.config.mts",
    "test:int": "vitest run --config ./vitest.int.config.mts",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "10.1.0",
    "graphql": "16.11.0",
    "lucide-react": "1.57.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "dotenv": "17.2.3",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "jsdom": "28.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "unrs-resolver@1.12.2": true
  }
}
