# Kopirajte u .env i prilagodite. Ovdje su samo imena i bezopasni primjeri — nikad stvarne tajne.

# --- Baza ---
# Lokalni razvoj (npm run db pokreće ugrađeni PostgreSQL na ovom portu):
DATABASE_URL=postgres://snk:snk_local_dev@127.0.0.1:5433/srce_nase_kuhinje

# --- Payload ---
# Dug nasumičan niz (npr. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
PAYLOAD_SECRET=zamijenite-dugim-nasumicnim-nizom

# --- Sajt ---
# development | preview | production
SITE_ENV=development
# Javni origin bez kose crte na kraju. Za produkciju upisati STVARNU domenu kad bude odabrana.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Indeksiranje je dozvoljeno samo kad je SITE_ENV=production I ova vrijednost true.
SITE_ALLOW_INDEXING=false
# Tajna za preview linkove iz CMS-a
PREVIEW_SECRET=zamijenite-nasumicnim-nizom

# --- Početni administrator (samo za lokalni seed) ---
SEED_ADMIN_EMAIL=urednik@example.com
SEED_ADMIN_PASSWORD=promijenite-ovu-lozinku

# --- Mediji (produkcija, S3-kompatibilno spremište) ---
# Ako S3_BUCKET nije postavljen, mediji se spremaju na lokalni disk (./media).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
